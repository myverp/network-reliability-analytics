# Development defaults use a local SQLite file and execute jobs inline.
NR_ENVIRONMENT=development
NR_DATABASE_URL=sqlite:///./network_reliability.db
NR_USE_INLINE_JOBS=true
NR_LOG_LEVEL=INFO
NR_MAX_EXACT_EDGES=20

# Required only when NR_USE_INLINE_JOBS=false.
# NR_REDIS_URL=redis://localhost:6379/0
